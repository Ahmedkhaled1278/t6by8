POSTGRES_USER=nour
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nour
DATABASE_URL=postgresql://nour:change-me-local-only@localhost:5432/nour?schema=public
REDIS_URL=redis://localhost:6379
# Production must use an HTTPS S3 endpoint and explicit non-default credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nour-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-local-only
# Optional public base for media (leave empty to use signed GET URLs)
S3_PUBLIC_BASE=
API_PORT=4000
WEB_PORT=3000

# URL that the browser / APK uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Comma-separated allowed web origins (include Capacitor origins for mobile). Production requires HTTPS web origins.
WEB_ORIGIN=http://localhost:3000,https://localhost,capacitor://localhost
# Never set CORS_REFLECT=1 in production; credentialed wildcard/reflected origins are rejected.

# Cookie settings for cross-origin Capacitor WebView (use none+secure in production HTTPS)
# COOKIE_SAMESITE=none
# COOKIE_SECURE=1
# MOBILE_CORS=1

# Live site URL loaded inside the APK shell (recommended for production)
# CAPACITOR_SERVER_URL=https://app.your-domain.com

# Comma-separated usernames allowed to moderate reports
ADMIN_USERNAMES=

# Optional SMTP (if unset, tokens are logged/returned in development only)
# Production requires SMTP_HOST, SMTP_USER, and SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nour.local
