generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}
enum MessageKind {
  TEXT
  IMAGE
  VIDEO
  FILE
  SYSTEM
}
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}
enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}
enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(30)
  email        String?  @unique @db.VarChar(254)
  passwordHash String?  @db.VarChar(255)
  emailVerifiedAt DateTime?
  sessions     AuthSession[]
  authTokens   AuthToken[]
  pushSubscriptions PushSubscription[]
  displayName  String   @db.VarChar(80)
  bio          String?  @db.VarChar(500)
  avatarKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     Message[]
  memberships  ConversationMember[]
  posts        Post[]
  comments     Comment[]
  followsOut   Follow[] @relation("FollowFrom")
  followsIn    Follow[] @relation("FollowTo")
  stories      Story[]
  postReactions PostReaction[]
  storyViews    StoryView[]
  reportsMade  Report[] @relation("ReportAuthor")
  blockedOut   UserBlock[] @relation("Blocker")
  blockedIn    UserBlock[] @relation("Blocked")
  notifications Notification[] @relation("NotificationRecipient")
  @@index([createdAt])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt, expiresAt])
}


model AuthToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   @db.VarChar(30)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type, expiresAt])
}

model UserBlock {
  blockerId String @db.Uuid
  blockedId String @db.Uuid
  createdAt DateTime @default(now())
  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Follow {
  followerId String @db.Uuid
  followedId String @db.Uuid
  createdAt DateTime @default(now())
  follower User @relation("FollowFrom", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("FollowTo", fields: [followedId], references: [id], onDelete: Cascade)
  @@id([followerId, followedId])
  @@index([followedId, createdAt])
}

model Conversation {
  id        String @id @default(uuid()) @db.Uuid
  type      ConversationType
  title     String? @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ConversationMember[]
  messages  Message[]
  @@index([updatedAt])
}

model ConversationMember {
  conversationId String @db.Uuid
  userId         String @db.Uuid
  role           MembershipRole @default(MEMBER)
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id              String @id @default(uuid()) @db.Uuid
  conversationId  String @db.Uuid
  senderId        String @db.Uuid
  clientMessageId String @db.VarChar(100)
  sequence        BigInt
  kind            MessageKind @default(TEXT)
  body            String? @db.Text
  createdAt       DateTime @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@unique([senderId, clientMessageId])
  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Post {
  id         String @id @default(uuid()) @db.Uuid
  authorId   String @db.Uuid
  body       String? @db.VarChar(5000)
  visibility PostVisibility @default(PUBLIC)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  reactions PostReaction[]
  media PostMedia[]
  @@index([createdAt, id])
  @@index([authorId, createdAt])
}

model PostMedia {
  id        String @id @default(uuid()) @db.Uuid
  postId    String @db.Uuid
  objectKey String
  mediaType String @db.VarChar(100)
  byteSize  BigInt
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId])
}

model Comment {
  id        String @id @default(uuid()) @db.Uuid
  postId    String @db.Uuid
  authorId  String @db.Uuid
  parentId  String? @db.Uuid
  body      String @db.VarChar(3000)
  createdAt DateTime @default(now())
  deletedAt DateTime?
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentThread")
  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model PostReaction {
  postId    String @db.Uuid
  userId    String @db.Uuid
  kind      String @default("like") @db.VarChar(30)
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
  @@index([userId, createdAt])
}

model Story {
  id        String @id @default(uuid()) @db.Uuid
  authorId  String @db.Uuid
  objectKey String
  mediaType String @db.VarChar(100)
  caption   String? @db.VarChar(500)
  createdAt DateTime @default(now())
  expiresAt DateTime
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views StoryView[]
  @@index([expiresAt])
  @@index([authorId, createdAt])
}

model StoryView {
  storyId String @db.Uuid
  viewerId String @db.Uuid
  viewedAt DateTime @default(now())
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  @@id([storyId, viewerId])
  @@index([viewerId, viewedAt])
}

model Report {
  id          String @id @default(uuid()) @db.Uuid
  authorId    String @db.Uuid
  targetType  String @db.VarChar(40)
  targetId    String @db.VarChar(100)
  reason      String @db.VarChar(100)
  details     String? @db.VarChar(2000)
  status      ReportStatus @default(OPEN)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  author User @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  @@index([status, createdAt])
  @@index([targetType, targetId])
}


model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  type        String   @db.VarChar(40)
  title       String   @db.VarChar(200)
  body        String?  @db.VarChar(500)
  actorId     String?  @db.Uuid
  targetType  String?  @db.VarChar(40)
  targetId    String?  @db.VarChar(100)
  readAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([userId, readAt])
}


model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
